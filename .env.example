# Supabase Configuration (From Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend / Server-side Google Gemini AI Keys (Stored securely in Supabase Cloud Secrets, NEVER exposed with VITE_ prefix)
# Primary Gemini API Key (Used for food analysis and general AI queries)
GEMINI_API_KEY=your_primary_gemini_api_key

# Secondary / Fallback Gemini API Key (Used for automatic failover on rate limits or dedicated coach quotas)
# Note: Can be named GEMINI_FALLBACK_API_KEY or GEMINI_COACH_API_KEY
GEMINI_FALLBACK_API_KEY=your_second_gemini_api_key
